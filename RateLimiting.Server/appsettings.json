{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenBucket": {
      "Capacity": 5,
      "RefillRatePerSecond": 1
    },
    "LeakingBucket": {
      "Capacity": 5,
      "LeakRatePerSecond": 1
    },
    "FixedWindowCounter": {
      "Limit": 5,
      "Window": "00:00:10"
    },
    "SlidingWindowLog": {
      "Limit": 5,
      "Window": "00:00:10"
    },
    "SlidingWindowCounter": {
      "Limit": 5,
      "Window": "00:00:10"
    },
    "Rules": {
      "FilePath": "rate-limit-rules.json",
      "RefreshInterval": "00:00:05",
      "RejectedRequestBehavior": "Queue",
      "QueueKey": "rate-limit:rejected-requests",
      "QueueMaxLength": 10000,
      "QueuedBodyMaxBytes": 65536
    }
  }
}
