{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenBucket": {
      "Capacity": 5,
      "RefillRatePerSecond": 1
    },
    "LeakingBucket": {
      "Capacity": 5,
      "LeakRatePerSecond": 1
    },
    "FixedWindowCounter": {
      "Limit": 5,
      "Window": "00:00:10"
    },
    "SlidingWindowLog": {
      "Limit": 5,
      "Window": "00:00:10"
    },
    "SlidingWindowCounter": {
      "Limit": 5,
      "Window": "00:00:10"
    }
  }
}
